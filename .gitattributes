# Track large files with Git LFS
*.db filter=lfs diff=lfs merge=lfs -text
*.sqlite filter=lfs diff=lfs merge=lfs -text
database/*.db filter=lfs diff=lfs merge=lfs -text
assets/*.png filter=lfs diff=lfs merge=lfs -text
assets/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/*.gif filter=lfs diff=lfs merge=lfs -text
assets/*.pdf filter=lfs diff=lfs merge=lfs -text
archives/*.zip filter=lfs diff=lfs merge=lfs -text
archives/*.tar.gz filter=lfs diff=lfs merge=lfs -text